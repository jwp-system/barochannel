BARO_DATABASE_URL=postgresql+asyncpg://barochannel:barochannel@localhost:5433/barochannel
# Windows 브라우저의 localhost는 IPv6를 먼저 시도한다. 127.0.0.1만 열면 연결마다 0.2초가 늦어진다.
BARO_HOST=::
BARO_PORT=8000
BARO_DEBUG=true
# 운영에서는 반드시 긴 임의 값으로 바꾼다. BARO_DEBUG=false이면 기본값으로는 시작되지 않는다.
BARO_SECRET_KEY=dev-only-secret-key
BARO_S3_ENDPOINT_URL=http://127.0.0.1:9000
BARO_S3_ACCESS_KEY=barochannel
BARO_S3_SECRET_KEY=barochannel
BARO_S3_BUCKET=barochannel
# 시스템 관리자 로그인 정보. PIN은 DB에 저장되고 처음 접속할 때 바꾼다.
BARO_ADMIN_EMAIL=admin@example.com
# 8자 이상. 운영에서는 긴 임의 값으로 정한다.
BARO_ADMIN_PASSWORD=
